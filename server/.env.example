# Copie este arquivo para server/.env (que fica fora do git) e ajuste.
# Nunca coloque senhas ou chaves reais neste .env.example.

# Porta da API (o app usa http://<IP-do-computador>:PORT)
PORT=3333
# 0.0.0.0 aceita conexões dos celulares na mesma Wi-Fi; 127.0.0.1 só deste computador
HOST=0.0.0.0
# Origens liberadas no CORS, separadas por vírgula ("*" = todas, só em desenvolvimento)
CORS_ORIGEM=*
# Máximo de requisições por IP por minuto
LIMITE_REQUISICOES_POR_MINUTO=300
# Outro arquivo de banco (opcional; padrão: server/data/ajai.db)
# AJAI_DB=server/data/ajai.db

# Login (passo 3): segredo para assinar os tokens. OBRIGATÓRIO em produção. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Em desenvolvimento, se ficar vazio, o servidor gera um e guarda em server/data/jwt-segredo.local.
# JWT_SECRET=
# Validade do login no aparelho (ex.: 30d, 12h)
JWT_VALIDADE=30d
# Tentativas de login/cadastro por IP por minuto
LIMITE_LOGIN_POR_MINUTO=10

# Passo 10 (voz): narração gerada no servidor. Só o computador que GERA os áudios precisa disto
# (veja README › Narração por voz). Vazio = desligado: o app usa a voz do aparelho (expo-speech).
# "azure" (padrão: voz neural da Microsoft) ou "piper" (alternativa local, sem conta).
VOZ_PROVEDOR=azure
# Azure AI Speech: chave e região do recurso Speech (portal.azure.com › seu recurso › Chaves e Ponto de Extremidade).
# A chave é SEGREDO: só aqui no server/.env, nunca no app nem no git.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth
# Voz neural pt-BR (outras: pt-BR-AntonioNeural, pt-BR-ThalitaMultilingualNeural)
AZURE_VOZ=pt-BR-FranciscaNeural
# Tempo máximo (ms) esperando a voz (inclui as esperas quando a Azure pede calma, erro 429)
VOZ_TEMPO_LIMITE_MS=20000
# Outra pasta para os áudios (opcional; padrão: server/storage/audio)
# VOZ_PASTA_AUDIO=server/storage/audio

# Só se VOZ_PROVEDOR=piper: rota do servidor HTTP do Piper e voz pt-BR
# PIPER_URL=http://127.0.0.1:5050/synthesize
# PIPER_VOZ=pt_BR-faber-medium
