# Copie este arquivo para server/.env (que fica fora do git) e ajuste.
# Nunca coloque senhas ou chaves reais neste .env.example.

# Porta da API (o app usa http://<IP-do-computador>:PORT)
PORT=3333
# 0.0.0.0 aceita conexões dos celulares na mesma Wi-Fi; 127.0.0.1 só deste computador
HOST=0.0.0.0
# Origens liberadas no CORS, separadas por vírgula ("*" = todas, só em desenvolvimento)
CORS_ORIGEM=*
# Máximo de requisições por IP por minuto
LIMITE_REQUISICOES_POR_MINUTO=300
# Outro arquivo de banco (opcional; padrão: server/data/ajai.db)
# AJAI_DB=server/data/ajai.db

# Passo 3 (login): segredo para assinar os tokens. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=

# Passo 6 (voz): configuração do Piper
# VOZ_PROVEDOR=piper
# PIPER_BIN=
# PIPER_MODELO=
